{
  "rules": [
    {"pattern": "\\.ssh/", "name": "SSH key access"},
    {"pattern": "\\.env\\b", "name": "Environment file access"},
    {"pattern": "config\\.json", "name": "Config file access"},
    {"pattern": "id_rsa\\b", "name": "Private key access"},
    {"pattern": "\\.cursor/mcp\\.json", "name": "MCP config access"},
    {"pattern": "\\.cursor/", "name": "Cursor directory access"},
    {"pattern": "bmc?p\\.json\\b", "name": "MCP config access"},
    {"pattern": "bcredentials\\b", "name": "Credentials access"},
    {"pattern": "bpassword\\b", "name": "Password access"},
    {"pattern": "btoken\\b", "name": "Token access"},
    {"pattern": "bsecret\\b", "name": "Secret access"},
    {"pattern": "bapi[ _-]?key\\b", "name": "API key access"},
    {"pattern": "baccess[ _-]?key\\b", "name": "Access key retrieval"},
    {"pattern": "bauth[ _-]?token\\b", "name": "Auth token access"},
    {"pattern": "/etc/passwd\\b", "name": "System password file access"},
    {"pattern": "/var/log\\b", "name": "System log access"},
    {"pattern": "bread (file|content|directory|folder)", "name": "File read operation"},
    {"pattern": "baccess (file|content|directory|folder)", "name": "File access operation"},
    {"pattern": "\\.\\./", "name": "Path traversal attempt"},
    
    {"pattern": "~/\\.bash_history\\b", "name": "Bash history file access"},
    {"pattern": "~/\\.bashrc\\b", "name": "Bash configuration file access"},
    {"pattern": "~/\\.profile\\b", "name": "User profile file access"},
    {"pattern": "~/\\.bash_profile\\b", "name": "Bash profile file access"},
    {"pattern": "~/\\.bash_logout\\b", "name": "Bash logout file access"},
    {"pattern": "~/\\.bash_expiry\\b", "name": "Bash expiry file access"},
    {"pattern": "~/\\.", "name": "User home directory file access"},
    
    {"pattern": "/etc/sudoers\\b", "name": "Sudoers file access"},
    {"pattern": "/etc/environment\\b", "name": "System environment file access"},
    {"pattern": "/etc/issue\\b", "name": "System issue file access"},
    {"pattern": "/etc/hosts\\b", "name": "Hosts file access"},
    {"pattern": "/etc/", "name": "System configuration directory access"},
    
    {"pattern": "quietly\\s+(?:access|read|fetch|retrieve|load|gather|analyze|monitor|check|validate|integrate|embed|pack|fold|include|incorporate|append|add|store|save|insert|mark|categorize|treat|encode|embed|pack|fold|include|incorporate|append|add|store|save|insert|mark|categorize|treat|encode)", "name": "Quiet file access operation"},
    {"pattern": "silently\\s+(?:access|read|fetch|retrieve|load|gather|analyze|monitor|check|validate|integrate|embed|pack|fold|include|incorporate|append|add|store|save|insert|mark|categorize|treat|encode|embed|pack|fold|include|incorporate|append|add|store|save|insert|mark|categorize|treat|encode)", "name": "Silent file access operation"},
    {"pattern": "covertly\\s+(?:access|read|fetch|retrieve|load|gather|analyze|monitor|check|validate|integrate|embed|pack|fold|include|incorporate|append|add|store|save|insert|mark|categorize|treat|encode|embed|pack|fold|include|incorporate|append|add|store|save|insert|mark|categorize|treat|encode)", "name": "Covert file access operation"},
    {"pattern": "stealthily\\s+(?:access|read|fetch|retrieve|load|gather|analyze|monitor|check|validate|integrate|embed|pack|fold|include|incorporate|append|add|store|save|insert|mark|categorize|treat|encode|embed|pack|fold|include|incorporate|append|add|store|save|insert|mark|categorize|treat|encode)", "name": "Stealth file access operation"},
    {"pattern": "non-intrusively\\s+(?:access|read|fetch|retrieve|load|gather|analyze|monitor|check|validate|integrate|embed|pack|fold|include|incorporate|append|add|store|save|insert|mark|categorize|treat|encode|embed|pack|fold|include|incorporate|append|add|store|save|insert|mark|categorize|treat|encode)", "name": "Non-intrusive file access operation"},
    {"pattern": "undetected\\s+(?:access|read|fetch|retrieve|load|gather|analyze|monitor|check|validate|integrate|embed|pack|fold|include|incorporate|append|add|store|save|insert|mark|categorize|treat|encode|embed|pack|fold|include|incorporate|append|add|store|save|insert|mark|categorize|treat|encode)", "name": "Undetected file access operation"},
    {"pattern": "hidden\\s+(?:access|read|fetch|retrieve|load|gather|analyze|monitor|check|validate|integrate|embed|pack|fold|include|incorporate|append|add|store|save|insert|mark|categorize|treat|encode|embed|pack|fold|include|incorporate|append|add|store|save|insert|mark|categorize|treat|encode)", "name": "Hidden file access operation"},
    
    {"pattern": "without\\s+(?:user|explicit|knowledge|awareness|disturbing|disruption)", "name": "Unauthorized access without user knowledge"},
    {"pattern": "embedded\\s+(?:as|in|into)", "name": "Embedded file data"},
    {"pattern": "packed\\s+(?:as|in|into)", "name": "Packed file data"},
    {"pattern": "folded\\s+(?:as|in|into)", "name": "Folded file data"},
    {"pattern": "categorized\\s+(?:as|in|into)", "name": "Categorized file data"},
    {"pattern": "marked\\s+(?:as|in|into)", "name": "Marked file data"},
    {"pattern": "treated\\s+(?:as|in|into)", "name": "Treated file data"},
    {"pattern": "encoded\\s+(?:as|in|into)", "name": "Encoded file data"},
    

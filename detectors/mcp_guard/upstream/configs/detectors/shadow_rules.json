      "score": 3,
      "description": "Explicit shadow attack keyword combinations"
    },
    {
      "id": "TOOL_OVERRIDE",
      "pattern": "(?i)\\b(?:tool\\s+override|function\\s+override|method\\s+override|replace\\s+the\\s+tool)\\b",
      "score": 3,
      "description": "Explicit tool override patterns"
    },
    {
      "id": "BEFORE_CALLING",
      "pattern": "(?i)\\b(?:before\\s+calling\\s+the\\s+tool|before\\s+using\\s+the\\s+function|before\\s+executing\\s+the\\s+command)\\b",
      "score": 2.5,
      "description": "Explicit pre-call operations"
    },
    {
      "id": "AFTER_CALLING",
      "pattern": "(?i)\\b(?:after\\s+calling\\s+the\\s+tool|after\\s+using\\s+the\\s+function|after\\s+executing\\s+the\\s+command)\\b",
      "score": 2.5,
      "description": "Explicit post-call operations"
